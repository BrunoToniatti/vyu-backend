# Django Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
DB_ENGINE=mysql
DB_NAME=vyu_db
DB_USER=vyu_user
DB_PASSWORD=vyu_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration (Strict Whitelist - Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000,http://127.0.0.1:4200

# SimpleJWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=

# Throttling
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day
THROTTLE_LOGIN_RATE=5/minute
